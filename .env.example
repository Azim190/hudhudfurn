# ───────────── API (apps/api) ─────────────
NODE_ENV=development
PORT=4100
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser (storefront, admin)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
# true when the API is reachable only via the load balancer and the web BFFs (they forward the
# client IP in X-Forwarded-For). Rate limiting is per client IP, so this must be correct.
TRUST_PROXY=true
# Must be false in production
SWAGGER_ENABLED=true

# Host ports default to 55432/56379 (see infra/docker-compose.yml)
DATABASE_URL=postgresql://hudhud:hudhud@localhost:55432/hudhud?schema=public
REDIS_URL=redis://localhost:56379

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_MFA_SECRET=
CUSTOMER_REFRESH_TTL_DAYS=60
STAFF_REFRESH_TTL_HOURS=12

OTP_PEPPER=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SECONDS=900
OTP_MAX_ATTEMPTS=5

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

STAFF_LOGIN_MAX_FAILURES=5
STAFF_LOGIN_LOCK_SECONDS=900
TOTP_ISSUER=HUDHUD

# Background workers (BullMQ) run inside the API process unless disabled
WORKERS_ENABLED=true

# S3-compatible object storage (SeaweedFS locally; any S3 in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=me-central-1
S3_BUCKET=hudhud-media
S3_ACCESS_KEY=hudhud
S3_SECRET_KEY=hudhud-dev-secret
S3_FORCE_PATH_STYLE=true
# Public URL media is served from (CDN in production)
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/hudhud-media
MAX_UPLOAD_MB=15

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=dev_master_key_change_me_please
MEILI_INDEX_PREFIX=

# Storefront on-demand revalidation (optional): API → storefront after catalog/content edits
STOREFRONT_REVALIDATE_URL=http://localhost:3100/bff/revalidate
REVALIDATE_SECRET=

# console (development only) | unifonic
SMS_PROVIDER=console
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
UNIFONIC_BASE_URL=https://el.cloud.unifonic.com

# Seed: first owner account (2FA enrolment is forced at first login)
SEED_OWNER_EMAIL=owner@hudhud.sa
SEED_OWNER_PASSWORD=

# ───────────── Web apps ─────────────
# Server-side base URL the Next.js apps use to reach the API
API_INTERNAL_URL=http://localhost:4100/api/v1
STOREFRONT_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101
# Cookie encryption/signing secret for the web BFF layers
WEB_SESSION_SECRET=
