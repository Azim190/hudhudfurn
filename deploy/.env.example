# Production environment for deploy/compose.yml. On the server:
#   bash scripts/init-env.sh      # copies this file to .env and generates every __GENERATE_*__ value
# then fill in the blanks below. The real .env stays on the server only (it is gitignored).
# Keep an offline copy of the finished .env (password manager): without ENCRYPTION_KEY a database
# backup cannot decrypt staff 2FA secrets, and without ZATCA_PRIVATE_KEY the invoice chain breaks.
#
# Do not add empty lines for URL settings that have defaults (MOYASAR_BASE_URL, TABBY_BASE_URL, ...):
# an empty value fails validation. Leave them out or give a full URL.

# ───────────── Site ─────────────
# Bare domain, without https:// or www. The stack serves <domain>, www.<domain> and api.<domain>.
DOMAIN=example.sa
# GitHub owner in lowercase: images are ghcr.io/<owner>/hudhud-{api,storefront,admin}
GHCR_OWNER=azim190
# Set by scripts/deploy.sh on each deployment
IMAGE_TAG=latest
# production for the live store. "development" is for a staging run before Unifonic, payment and
# ZATCA credentials exist (see "Staging" in deploy/README.md); never with real customers.
API_NODE_ENV=production

# ───────────── Databases (internal only) ─────────────
POSTGRES_USER=hudhud
POSTGRES_DB=hudhud
POSTGRES_PASSWORD=__GENERATE_HEX__
REDIS_PASSWORD=__GENERATE_HEX__
MEILI_MASTER_KEY=__GENERATE_HEX__

# ───────────── API secrets ─────────────
JWT_ACCESS_SECRET=__GENERATE_B64URL__
JWT_MFA_SECRET=__GENERATE_B64URL__
OTP_PEPPER=__GENERATE_B64URL__
ENCRYPTION_KEY=__GENERATE_KEY32__
REVALIDATE_SECRET=__GENERATE_B64URL__

# ───────────── API settings ─────────────
LOG_LEVEL=info
STAFF_MFA_REQUIRED=true
TOTP_ISSUER=HUDHUD
WORKERS_ENABLED=true
MAX_UPLOAD_MB=15
# Limits sharp/libvips memory while making image renditions
VIPS_CONCURRENCY=2
MALLOC_ARENA_MAX=2

# ───────────── Media storage: Cloudflare R2 ─────────────
# R2 > Overview > S3 API: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_BUCKET=hudhud-media
# Customer uploads. This bucket must never be public.
S3_PRIVATE_BUCKET=hudhud-private
# R2 API token with Object Read & Write on both buckets
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Custom domain connected to the public hudhud-media bucket
MEDIA_PUBLIC_BASE_URL=https://media.example.sa

# ───────────── SMS (customer sign-in codes) ─────────────
# unifonic is required in production. console only works with API_NODE_ENV=development.
SMS_PROVIDER=unifonic
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# ───────────── Payments ─────────────
# true opens a fake payment page (staging only; refused in production)
PAYMENTS_SIMULATOR=false
# Moyasar: mada, Visa, Mastercard, Apple Pay. Webhook URL: https://api.<domain>/api/v1/payments/webhooks/moyasar
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# Tabby. Webhook URL: https://api.<domain>/api/v1/payments/webhooks/tabby
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=
# Tamara. Webhook URL: https://api.<domain>/api/v1/payments/webhooks/tamara
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
# The code defaults to Tamara's sandbox. Keep this line for live payments.
TAMARA_BASE_URL=https://api.tamara.co

# ───────────── ZATCA e-invoicing ─────────────
# off: sign and store only. simulation first, then production (docs/adr/0004-checkout-payments-e-invoicing.md)
ZATCA_MODE=off
# Required in production: bash scripts/init-env.sh fills it with a new secp256k1 key (SEC1 PEM, base64).
# If you already onboarded with another key, paste that one instead: the CSID is tied to it.
ZATCA_PRIVATE_KEY=__GENERATE_ZATCA_KEY__
ZATCA_CSID_TOKEN=
ZATCA_CSID_SECRET=

# ───────────── First owner account ─────────────
# Used once by "prisma db seed" on the first deployment. Delete both values afterwards.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ───────────── Backups → Cloudflare R2 ─────────────
# A separate bucket (hudhud-backups) and a separate R2 token limited to it
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_BUCKET=hudhud-backups
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
# Cron in UTC: 00:30 UTC = 03:30 Riyadh time
BACKUP_CRON=30 0 * * *
KEEP_LOCAL_DAYS=7
