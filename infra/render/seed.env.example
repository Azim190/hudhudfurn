# Copy to .env.render.local (gitignored) and fill in. Used only by scripts/seed-render.sh.

# Render dashboard > hudhudfurn-db > Connect > External Database URL, with this added to the end:
#   ?sslmode=require
DATABASE_URL=

# Same values you entered in the Render Blueprint form
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_PUBLIC_BASE_URL=
S3_REGION=auto
S3_BUCKET=hudhudfurn-media
S3_PRIVATE_BUCKET=hudhudfurn-private

# First admin account. Use a long, unique password.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Render dashboard > hudhudfurn-api > Environment
ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_MFA_SECRET=
OTP_PEPPER=
