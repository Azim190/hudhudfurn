// HUDHUD data model. See docs/planning/01-erd.md for the full ERD.
// Conventions: uuid ids, snake_case tables/columns, money in integer halalas, lengths in mm.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity & access ───────────────────────────────

enum UserKind {
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Locale {
  ar
  en
}

enum DigitStyle {
  western
  arabic_indic
}

enum CalendarPreference {
  gregory
  islamic_umalqura
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  kind         UserKind
  phoneE164    String?            @unique @map("phone_e164")
  email        String?            @unique
  passwordHash String?            @map("password_hash")
  fullName     String?            @map("full_name")
  locale       Locale             @default(ar)
  digits       DigitStyle         @default(western)
  calendar     CalendarPreference @default(gregory)
  status       UserStatus         @default(ACTIVE)
  lastLoginAt  DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(3)

  roles        UserRole[]
  sessions     Session[]
  totp         TotpSecret?
  addresses    Address[]
  consents     ConsentRecord[]
  dataRequests DataSubjectRequest[]
  auditLogs    AuditLog[]

  @@index([kind, status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  nameAr      String           @map("name_ar")
  nameEn      String           @map("name_en")
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  key   String           @id
  group String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// One row per issued refresh token. Rotation creates a new row in the same family and revokes
/// the previous one; presenting a revoked token revokes the whole family (theft detection).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  mfaVerified      Boolean   @default(false) @map("mfa_verified")
  ip               String?
  userAgent        String?   @map("user_agent")
  deviceLabel      String?   @map("device_label")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model TotpSecret {
  userId              String    @id @map("user_id") @db.Uuid
  secretEncrypted     String    @map("secret_encrypted")
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// argon2 hashes of single-use recovery codes; used codes are removed.
  recoveryCodesHashed String[]  @map("recovery_codes_hashed")
  lastUsedStep        BigInt?   @map("last_used_step")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_secrets")
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  phoneE164  String     @map("phone_e164")
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  ip         String?
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, purpose, createdAt])
  @@map("otp_challenges")
}

// ─────────────────────────────── Geography & addresses ───────────────────────────────

model City {
  id         String     @id @default(uuid()) @db.Uuid
  code       String     @unique
  nameAr     String     @map("name_ar")
  nameEn     String     @map("name_en")
  regionCode String     @map("region_code")
  codAllowed Boolean    @default(true) @map("cod_allowed")
  isActive   Boolean    @default(true) @map("is_active")
  sortOrder  Int        @default(0) @map("sort_order")
  districts  District[]
  addresses  Address[]

  @@map("cities")
}

model District {
  id        String    @id @default(uuid()) @db.Uuid
  cityId    String    @map("city_id") @db.Uuid
  nameAr    String    @map("name_ar")
  nameEn    String    @map("name_en")
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  addresses Address[]

  @@unique([cityId, nameAr])
  @@map("districts")
}

model Address {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  label         String?
  recipientName String    @map("recipient_name")
  phoneE164     String    @map("phone_e164")
  cityId        String    @map("city_id") @db.Uuid
  districtId    String?   @map("district_id") @db.Uuid
  street        String?
  buildingNo    String?   @map("building_no")
  additionalNo  String?   @map("additional_no")
  postalCode    String?   @map("postal_code")
  /// Saudi National Address short code, e.g. RRRD2929.
  shortAddress  String?   @map("short_address")
  lat           Decimal?  @db.Decimal(9, 6)
  lng           Decimal?  @db.Decimal(9, 6)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City      @relation(fields: [cityId], references: [id])
  district      District? @relation(fields: [districtId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── PDPL ───────────────────────────────

enum ConsentPurpose {
  MARKETING_SMS
  MARKETING_WHATSAPP
  MARKETING_EMAIL
  MARKETING_PUSH
  ANALYTICS
  PERSONALIZATION
}

model ConsentRecord {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String         @map("policy_version")
  ip            String?
  recordedAt    DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, recordedAt])
  @@map("consent_records")
}

enum DataRequestType {
  EXPORT
  DELETE
  RECTIFY
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  DONE
  REJECTED
}

model DataSubjectRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  note        String?
  resultUrl   String?           @map("result_url")
  processedAt DateTime?         @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("data_subject_requests")
}

// ─────────────────────────────── Audit & settings ───────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  at         DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([at])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

// ─────────────────────────────── Catalog ───────────────────────────────
// Localized text is stored as *_ar / *_en column pairs: Arabic required, English optional.

enum Vertical {
  CURTAINS
  BEDDING
  SOFA_COVERS
  ABAYAS
  ACCESSORIES
}

enum AttributeType {
  SELECT
  MULTISELECT
  BOOLEAN
  NUMBER
  COLOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PricingMode {
  FIXED
  PER_METER
  PER_SQM
  CALCULATED
}

enum PhotoStyle {
  ON_MODEL
  MANNEQUIN
  FLAT_LAY
  LIFESTYLE
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum CollectionType {
  MANUAL
  SEASONAL
  RAMADAN
  EID
  BACK_TO_SCHOOL
  NATIONAL_DAY
}

enum RelationType {
  CROSS_SELL
  COMPLETE_THE_LOOK
  UPSELL
  ACCESSORY
}

model Category {
  id               String              @id @default(uuid()) @db.Uuid
  parentId         String?             @map("parent_id") @db.Uuid
  vertical         Vertical
  nameAr           String              @map("name_ar")
  nameEn           String?             @map("name_en")
  slugAr           String              @unique @map("slug_ar")
  slugEn           String              @unique @map("slug_en")
  descriptionAr    String?             @map("description_ar") @db.Text
  descriptionEn    String?             @map("description_en") @db.Text
  seoTitleAr       String?             @map("seo_title_ar")
  seoTitleEn       String?             @map("seo_title_en")
  seoDescriptionAr String?             @map("seo_description_ar")
  seoDescriptionEn String?             @map("seo_description_en")
  imageId          String?             @map("image_id") @db.Uuid
  sizeGuideId      String?             @map("size_guide_id") @db.Uuid
  sortOrder        Int                 @default(0) @map("sort_order")
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent           Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]          @relation("CategoryTree")
  image            MediaAsset?         @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  sizeGuide        SizeGuide?          @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  attributes       CategoryAttribute[]
  products         Product[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Attribute {
  id         String              @id @default(uuid()) @db.Uuid
  key        String              @unique
  nameAr     String              @map("name_ar")
  nameEn     String?             @map("name_en")
  type       AttributeType       @default(SELECT)
  unit       String?
  sortOrder  Int                 @default(0) @map("sort_order")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  values     AttributeValue[]
  categories CategoryAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id           String                  @id @default(uuid()) @db.Uuid
  attributeId  String                  @map("attribute_id") @db.Uuid
  code         String
  labelAr      String                  @map("label_ar")
  labelEn      String?                 @map("label_en")
  swatchHex    String?                 @map("swatch_hex")
  numericValue Decimal?                @map("numeric_value") @db.Decimal(12, 3)
  sortOrder    Int                     @default(0) @map("sort_order")
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products     ProductAttributeValue[]
  variants     VariantOptionValue[]

  @@unique([attributeId, code])
  @@map("attribute_values")
}

/// Which attributes a category uses, and how: storefront facet, variant axis, required in the editor.
model CategoryAttribute {
  categoryId    String    @map("category_id") @db.Uuid
  attributeId   String    @map("attribute_id") @db.Uuid
  isFacet       Boolean   @default(true) @map("is_facet")
  isVariantAxis Boolean   @default(false) @map("is_variant_axis")
  isRequired    Boolean   @default(false) @map("is_required")
  sortOrder     Int       @default(0) @map("sort_order")
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute     Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@map("category_attributes")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  nameAr    String    @map("name_ar")
  nameEn    String?   @map("name_en")
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  products  Product[]

  @@map("brands")
}

model Product {
  id               String                  @id @default(uuid()) @db.Uuid
  categoryId       String                  @map("category_id") @db.Uuid
  brandId          String?                 @map("brand_id") @db.Uuid
  skuPrefix        String                  @unique @map("sku_prefix")
  nameAr           String                  @map("name_ar")
  nameEn           String?                 @map("name_en")
  slugAr           String                  @unique @map("slug_ar")
  slugEn           String                  @unique @map("slug_en")
  descriptionAr    String?                 @map("description_ar") @db.Text
  descriptionEn    String?                 @map("description_en") @db.Text
  careAr           String?                 @map("care_ar") @db.Text
  careEn           String?                 @map("care_en") @db.Text
  seoTitleAr       String?                 @map("seo_title_ar")
  seoTitleEn       String?                 @map("seo_title_en")
  seoDescriptionAr String?                 @map("seo_description_ar")
  seoDescriptionEn String?                 @map("seo_description_en")
  pricingMode      PricingMode             @default(FIXED) @map("pricing_mode")
  /// Halalas: per unit (FIXED), per metre (PER_METER), per square metre (PER_SQM), or "from" price (CALCULATED).
  basePrice        Int                     @map("base_price")
  compareAtPrice   Int?                    @map("compare_at_price")
  vatInclusive     Boolean                 @default(true) @map("vat_inclusive")
  status           ProductStatus           @default(DRAFT)
  isMadeToMeasure  Boolean                 @default(false) @map("is_made_to_measure")
  sampleAvailable  Boolean                 @default(false) @map("sample_available")
  samplePrice      Int?                    @map("sample_price")
  photoStyle       PhotoStyle?             @map("photo_style")
  sizeGuideId      String?                 @map("size_guide_id") @db.Uuid
  ratingAvg        Decimal                 @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int                     @default(0) @map("rating_count")
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(3)
  category         Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand            Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sizeGuide        SizeGuide?              @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  attributes       ProductAttributeValue[]
  media            ProductMedia[]
  collections      CollectionProduct[]
  relations        ProductRelation[]       @relation("ProductRelationSource")
  relatedFrom      ProductRelation[]       @relation("ProductRelationTarget")

  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@map("products")
}

/// Product-level attribute values (facets that do not create variants, e.g. fabric, opacity).
model ProductAttributeValue {
  productId        String         @map("product_id") @db.Uuid
  attributeValueId String         @map("attribute_value_id") @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value            AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@map("product_attribute_values")
}

model ProductVariant {
  id             String               @id @default(uuid()) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  sku            String               @unique
  barcode        String?              @unique
  /// Halalas; null means the product base price applies.
  price          Int?
  compareAtPrice Int?                 @map("compare_at_price")
  weightGrams    Int?                 @map("weight_grams")
  /// For fabric sold by length (curtains): usable fabric width in mm.
  fabricWidthMm  Int?                 @map("fabric_width_mm")
  /// Stable combination key, e.g. "color=black|size=M" (see domain combinationKey).
  optionKey      String               @map("option_key")
  isDefault      Boolean              @default(false) @map("is_default")
  isActive       Boolean              @default(true) @map("is_active")
  sortOrder      Int                  @default(0) @map("sort_order")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  options        VariantOptionValue[]
  media          ProductMedia[]
  stock          StockLevel[]
  movements      StockMovement[]

  @@unique([productId, optionKey])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId        String         @map("variant_id") @db.Uuid
  attributeValueId String         @map("attribute_value_id") @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value            AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@map("variant_option_values")
}

model MediaAsset {
  id          String         @id @default(uuid()) @db.Uuid
  kind        MediaKind      @default(IMAGE)
  status      MediaStatus    @default(PROCESSING)
  storageKey  String         @unique @map("storage_key")
  mime        String
  bytes       Int
  width       Int?
  height      Int?
  /// Array of { format: "webp" | "avif", width, key }
  renditions  Json?
  altAr       String?        @map("alt_ar")
  altEn       String?        @map("alt_en")
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  products    ProductMedia[]
  categories  Category[]     @relation("CategoryImage")
  collections Collection[]   @relation("CollectionImage")

  @@map("media_assets")
}

model ProductMedia {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  mediaId   String          @map("media_id") @db.Uuid
  /// Optional: image shown when this variant (e.g. a colour) is selected.
  variantId String?         @map("variant_id") @db.Uuid
  sortOrder Int             @default(0) @map("sort_order")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@map("product_media")
}

model SizeGuide {
  id             String     @id @default(uuid()) @db.Uuid
  key            String     @unique
  titleAr        String     @map("title_ar")
  titleEn        String?    @map("title_en")
  /// { columns: [{ ar, en }], rows: [[cell, ...]] } where cells are plain strings or numbers.
  table          Json
  howToMeasureAr String?    @map("how_to_measure_ar") @db.Text
  howToMeasureEn String?    @map("how_to_measure_en") @db.Text
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories     Category[]
  products       Product[]

  @@map("size_guides")
}

model Collection {
  id            String              @id @default(uuid()) @db.Uuid
  type          CollectionType      @default(MANUAL)
  nameAr        String              @map("name_ar")
  nameEn        String?             @map("name_en")
  slugAr        String              @unique @map("slug_ar")
  slugEn        String              @unique @map("slug_en")
  descriptionAr String?             @map("description_ar") @db.Text
  descriptionEn String?             @map("description_en") @db.Text
  imageId       String?             @map("image_id") @db.Uuid
  startsAt      DateTime?           @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime?           @map("ends_at") @db.Timestamptz(3)
  isActive      Boolean             @default(true) @map("is_active")
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  image         MediaAsset?         @relation("CollectionImage", fields: [imageId], references: [id], onDelete: SetNull)
  products      CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String     @map("collection_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model ProductRelation {
  productId String       @map("product_id") @db.Uuid
  relatedId String       @map("related_id") @db.Uuid
  type      RelationType
  sortOrder Int          @default(0) @map("sort_order")
  product   Product      @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  related   Product      @relation("ProductRelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId, type])
  @@map("product_relations")
}

// ─────────────────────────────── Inventory ───────────────────────────────

enum LocationType {
  WAREHOUSE
  BRANCH
  WORKSHOP
}

enum StockReason {
  INITIAL
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVE
  RELEASE
  IMPORT
}

model Location {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  type          LocationType
  nameAr        String          @map("name_ar")
  nameEn        String?         @map("name_en")
  cityId        String?         @map("city_id") @db.Uuid
  isPickupPoint Boolean         @default(false) @map("is_pickup_point")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  stock         StockLevel[]
  movements     StockMovement[]

  @@map("locations")
}

/// Units for most items; centimetres for fabric sold by length.
model StockLevel {
  variantId         String         @map("variant_id") @db.Uuid
  locationId        String         @map("location_id") @db.Uuid
  onHand            Int            @default(0) @map("on_hand")
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5) @map("low_stock_threshold")
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location          Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([variantId, locationId])
  @@map("stock_levels")
}

model StockMovement {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  locationId String         @map("location_id") @db.Uuid
  /// Signed change to on_hand (or to reserved for RESERVE/RELEASE).
  quantity   Int
  reason     StockReason
  refType    String?        @map("ref_type")
  refId      String?        @map("ref_id")
  note       String?
  actorId    String?        @map("actor_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────── Jobs ───────────────────────────────

enum JobKind {
  PRODUCT_IMPORT
  PRODUCT_EXPORT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model BackgroundJob {
  id          String    @id @default(uuid()) @db.Uuid
  kind        JobKind
  status      JobStatus @default(QUEUED)
  inputKey    String?   @map("input_key")
  resultKey   String?   @map("result_key")
  /// { created, updated, failed, errors: [{ row, message }] }
  summary     Json?
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@map("background_jobs")
}
