// HUDHUD data model. See docs/planning/01-erd.md for the full ERD.
// Conventions: uuid ids, snake_case tables/columns, money in integer halalas, lengths in mm.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity & access ───────────────────────────────

enum UserKind {
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Locale {
  ar
  en
}

enum DigitStyle {
  western
  arabic_indic
}

enum CalendarPreference {
  gregory
  islamic_umalqura
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  kind         UserKind
  phoneE164    String?            @unique @map("phone_e164")
  email        String?            @unique
  passwordHash String?            @map("password_hash")
  fullName     String?            @map("full_name")
  locale       Locale             @default(ar)
  digits       DigitStyle         @default(western)
  calendar     CalendarPreference @default(gregory)
  status       UserStatus         @default(ACTIVE)
  lastLoginAt  DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(3)

  roles               UserRole[]
  sessions            Session[]
  totp                TotpSecret?
  addresses           Address[]
  consents            ConsentRecord[]
  dataRequests        DataSubjectRequest[]
  auditLogs           AuditLog[]
  wishlist            WishlistItem[]
  stockAlerts         BackInStockSubscription[]
  reviews             Review[]
  orders              Order[]
  measurementProfiles MeasurementProfile[]

  @@index([kind, status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  nameAr      String           @map("name_ar")
  nameEn      String           @map("name_en")
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  key   String           @id
  group String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// One row per issued refresh token. Rotation creates a new row in the same family and revokes
/// the previous one; presenting a revoked token revokes the whole family (theft detection).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  mfaVerified      Boolean   @default(false) @map("mfa_verified")
  ip               String?
  userAgent        String?   @map("user_agent")
  deviceLabel      String?   @map("device_label")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model TotpSecret {
  userId              String    @id @map("user_id") @db.Uuid
  secretEncrypted     String    @map("secret_encrypted")
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// argon2 hashes of single-use recovery codes; used codes are removed.
  recoveryCodesHashed String[]  @map("recovery_codes_hashed")
  lastUsedStep        BigInt?   @map("last_used_step")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_secrets")
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  phoneE164  String     @map("phone_e164")
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  ip         String?
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, purpose, createdAt])
  @@map("otp_challenges")
}

// ─────────────────────────────── Geography & addresses ───────────────────────────────

model City {
  id         String     @id @default(uuid()) @db.Uuid
  code       String     @unique
  nameAr     String     @map("name_ar")
  nameEn     String     @map("name_en")
  regionCode String     @map("region_code")
  codAllowed Boolean    @default(true) @map("cod_allowed")
  isActive   Boolean    @default(true) @map("is_active")
  sortOrder  Int        @default(0) @map("sort_order")
  districts  District[]
  addresses  Address[]

  @@map("cities")
}

model District {
  id        String    @id @default(uuid()) @db.Uuid
  cityId    String    @map("city_id") @db.Uuid
  nameAr    String    @map("name_ar")
  nameEn    String    @map("name_en")
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  addresses Address[]

  @@unique([cityId, nameAr])
  @@map("districts")
}

model Address {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  label         String?
  recipientName String    @map("recipient_name")
  phoneE164     String    @map("phone_e164")
  cityId        String    @map("city_id") @db.Uuid
  districtId    String?   @map("district_id") @db.Uuid
  street        String?
  buildingNo    String?   @map("building_no")
  additionalNo  String?   @map("additional_no")
  postalCode    String?   @map("postal_code")
  /// Saudi National Address short code, e.g. RRRD2929.
  shortAddress  String?   @map("short_address")
  lat           Decimal?  @db.Decimal(9, 6)
  lng           Decimal?  @db.Decimal(9, 6)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City      @relation(fields: [cityId], references: [id])
  district      District? @relation(fields: [districtId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── PDPL ───────────────────────────────

enum ConsentPurpose {
  MARKETING_SMS
  MARKETING_WHATSAPP
  MARKETING_EMAIL
  MARKETING_PUSH
  ANALYTICS
  PERSONALIZATION
}

model ConsentRecord {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String         @map("policy_version")
  ip            String?
  recordedAt    DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, recordedAt])
  @@map("consent_records")
}

enum DataRequestType {
  EXPORT
  DELETE
  RECTIFY
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  DONE
  REJECTED
}

model DataSubjectRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  note        String?
  resultUrl   String?           @map("result_url")
  processedAt DateTime?         @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("data_subject_requests")
}

// ─────────────────────────────── Audit & settings ───────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  at         DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([at])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

// ─────────────────────────────── Catalog ───────────────────────────────
// Localized text is stored as *_ar / *_en column pairs: Arabic required, English optional.

enum Vertical {
  CURTAINS
  BEDDING
  SOFA_COVERS
  ABAYAS
  ACCESSORIES
}

enum AttributeType {
  SELECT
  MULTISELECT
  BOOLEAN
  NUMBER
  COLOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PricingMode {
  FIXED
  PER_METER
  PER_SQM
  CALCULATED
}

enum PhotoStyle {
  ON_MODEL
  MANNEQUIN
  FLAT_LAY
  LIFESTYLE
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum CollectionType {
  MANUAL
  SEASONAL
  RAMADAN
  EID
  BACK_TO_SCHOOL
  NATIONAL_DAY
}

enum RelationType {
  CROSS_SELL
  COMPLETE_THE_LOOK
  UPSELL
  ACCESSORY
}

model Category {
  id               String              @id @default(uuid()) @db.Uuid
  parentId         String?             @map("parent_id") @db.Uuid
  vertical         Vertical
  nameAr           String              @map("name_ar")
  nameEn           String?             @map("name_en")
  slugAr           String              @unique @map("slug_ar")
  slugEn           String              @unique @map("slug_en")
  descriptionAr    String?             @map("description_ar") @db.Text
  descriptionEn    String?             @map("description_en") @db.Text
  seoTitleAr       String?             @map("seo_title_ar")
  seoTitleEn       String?             @map("seo_title_en")
  seoDescriptionAr String?             @map("seo_description_ar")
  seoDescriptionEn String?             @map("seo_description_en")
  imageId          String?             @map("image_id") @db.Uuid
  sizeGuideId      String?             @map("size_guide_id") @db.Uuid
  sortOrder        Int                 @default(0) @map("sort_order")
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent           Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]          @relation("CategoryTree")
  image            MediaAsset?         @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  sizeGuide        SizeGuide?          @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  attributes       CategoryAttribute[]
  products         Product[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Attribute {
  id         String              @id @default(uuid()) @db.Uuid
  key        String              @unique
  nameAr     String              @map("name_ar")
  nameEn     String?             @map("name_en")
  type       AttributeType       @default(SELECT)
  unit       String?
  sortOrder  Int                 @default(0) @map("sort_order")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  values     AttributeValue[]
  categories CategoryAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id           String                  @id @default(uuid()) @db.Uuid
  attributeId  String                  @map("attribute_id") @db.Uuid
  code         String
  labelAr      String                  @map("label_ar")
  labelEn      String?                 @map("label_en")
  swatchHex    String?                 @map("swatch_hex")
  numericValue Decimal?                @map("numeric_value") @db.Decimal(12, 3)
  sortOrder    Int                     @default(0) @map("sort_order")
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products     ProductAttributeValue[]
  variants     VariantOptionValue[]

  @@unique([attributeId, code])
  @@map("attribute_values")
}

/// Which attributes a category uses, and how: storefront facet, variant axis, required in the editor.
model CategoryAttribute {
  categoryId    String    @map("category_id") @db.Uuid
  attributeId   String    @map("attribute_id") @db.Uuid
  isFacet       Boolean   @default(true) @map("is_facet")
  isVariantAxis Boolean   @default(false) @map("is_variant_axis")
  isRequired    Boolean   @default(false) @map("is_required")
  sortOrder     Int       @default(0) @map("sort_order")
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute     Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@map("category_attributes")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  nameAr    String    @map("name_ar")
  nameEn    String?   @map("name_en")
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  products  Product[]

  @@map("brands")
}

model Product {
  id                     String                  @id @default(uuid()) @db.Uuid
  categoryId             String                  @map("category_id") @db.Uuid
  brandId                String?                 @map("brand_id") @db.Uuid
  skuPrefix              String                  @unique @map("sku_prefix")
  nameAr                 String                  @map("name_ar")
  nameEn                 String?                 @map("name_en")
  slugAr                 String                  @unique @map("slug_ar")
  slugEn                 String                  @unique @map("slug_en")
  descriptionAr          String?                 @map("description_ar") @db.Text
  descriptionEn          String?                 @map("description_en") @db.Text
  careAr                 String?                 @map("care_ar") @db.Text
  careEn                 String?                 @map("care_en") @db.Text
  seoTitleAr             String?                 @map("seo_title_ar")
  seoTitleEn             String?                 @map("seo_title_en")
  seoDescriptionAr       String?                 @map("seo_description_ar")
  seoDescriptionEn       String?                 @map("seo_description_en")
  pricingMode            PricingMode             @default(FIXED) @map("pricing_mode")
  /// Halalas: per unit (FIXED), per metre (PER_METER), per square metre (PER_SQM), or "from" price (CALCULATED).
  basePrice              Int                     @map("base_price")
  compareAtPrice         Int?                    @map("compare_at_price")
  vatInclusive           Boolean                 @default(true) @map("vat_inclusive")
  status                 ProductStatus           @default(DRAFT)
  isMadeToMeasure        Boolean                 @default(false) @map("is_made_to_measure")
  sampleAvailable        Boolean                 @default(false) @map("sample_available")
  samplePrice            Int?                    @map("sample_price")
  photoStyle             PhotoStyle?             @map("photo_style")
  sizeGuideId            String?                 @map("size_guide_id") @db.Uuid
  ratingAvg              Decimal                 @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount            Int                     @default(0) @map("rating_count")
  publishedAt            DateTime?               @map("published_at") @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sizeGuide              SizeGuide?              @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  variants               ProductVariant[]
  attributes             ProductAttributeValue[]
  media                  ProductMedia[]
  collections            CollectionProduct[]
  relations              ProductRelation[]       @relation("ProductRelationSource")
  relatedFrom            ProductRelation[]       @relation("ProductRelationTarget")
  wishlistedBy           WishlistItem[]
  reviews                Review[]
  configuratorTemplateId String?                 @map("configurator_template_id") @db.Uuid
  configuratorTemplate   ConfiguratorTemplate?   @relation(fields: [configuratorTemplateId], references: [id], onDelete: SetNull)

  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@map("products")
}

/// Product-level attribute values (facets that do not create variants, e.g. fabric, opacity).
model ProductAttributeValue {
  productId        String         @map("product_id") @db.Uuid
  attributeValueId String         @map("attribute_value_id") @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value            AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@map("product_attribute_values")
}

model ProductVariant {
  id             String                    @id @default(uuid()) @db.Uuid
  productId      String                    @map("product_id") @db.Uuid
  sku            String                    @unique
  barcode        String?                   @unique
  /// Halalas; null means the product base price applies.
  price          Int?
  compareAtPrice Int?                      @map("compare_at_price")
  weightGrams    Int?                      @map("weight_grams")
  /// For fabric sold by length (curtains): usable fabric width in mm.
  fabricWidthMm  Int?                      @map("fabric_width_mm")
  /// Stable combination key, e.g. "color=black|size=M" (see domain combinationKey).
  optionKey      String                    @map("option_key")
  isDefault      Boolean                   @default(false) @map("is_default")
  isActive       Boolean                   @default(true) @map("is_active")
  sortOrder      Int                       @default(0) @map("sort_order")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  options        VariantOptionValue[]
  media          ProductMedia[]
  stock          StockLevel[]
  movements      StockMovement[]
  cartItems      CartItem[]
  stockAlerts    BackInStockSubscription[]
  orderItems     OrderItem[]

  @@unique([productId, optionKey])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId        String         @map("variant_id") @db.Uuid
  attributeValueId String         @map("attribute_value_id") @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value            AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@map("variant_option_values")
}

model MediaAsset {
  id          String         @id @default(uuid()) @db.Uuid
  kind        MediaKind      @default(IMAGE)
  status      MediaStatus    @default(PROCESSING)
  storageKey  String         @unique @map("storage_key")
  mime        String
  bytes       Int
  width       Int?
  height      Int?
  /// Array of { format: "webp" | "avif", width, key }
  renditions  Json?
  altAr       String?        @map("alt_ar")
  altEn       String?        @map("alt_en")
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  products    ProductMedia[]
  categories  Category[]     @relation("CategoryImage")
  collections Collection[]   @relation("CollectionImage")
  bannersAr   Banner[]       @relation("BannerImageAr")
  bannersEn   Banner[]       @relation("BannerImageEn")

  @@map("media_assets")
}

model ProductMedia {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  mediaId   String          @map("media_id") @db.Uuid
  /// Optional: image shown when this variant (e.g. a colour) is selected.
  variantId String?         @map("variant_id") @db.Uuid
  sortOrder Int             @default(0) @map("sort_order")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@map("product_media")
}

model SizeGuide {
  id             String     @id @default(uuid()) @db.Uuid
  key            String     @unique
  titleAr        String     @map("title_ar")
  titleEn        String?    @map("title_en")
  /// { columns: [{ ar, en }], rows: [[cell, ...]] } where cells are plain strings or numbers.
  table          Json
  howToMeasureAr String?    @map("how_to_measure_ar") @db.Text
  howToMeasureEn String?    @map("how_to_measure_en") @db.Text
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories     Category[]
  products       Product[]

  @@map("size_guides")
}

model Collection {
  id            String              @id @default(uuid()) @db.Uuid
  type          CollectionType      @default(MANUAL)
  nameAr        String              @map("name_ar")
  nameEn        String?             @map("name_en")
  slugAr        String              @unique @map("slug_ar")
  slugEn        String              @unique @map("slug_en")
  descriptionAr String?             @map("description_ar") @db.Text
  descriptionEn String?             @map("description_en") @db.Text
  imageId       String?             @map("image_id") @db.Uuid
  startsAt      DateTime?           @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime?           @map("ends_at") @db.Timestamptz(3)
  isActive      Boolean             @default(true) @map("is_active")
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  image         MediaAsset?         @relation("CollectionImage", fields: [imageId], references: [id], onDelete: SetNull)
  products      CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String     @map("collection_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model ProductRelation {
  productId String       @map("product_id") @db.Uuid
  relatedId String       @map("related_id") @db.Uuid
  type      RelationType
  sortOrder Int          @default(0) @map("sort_order")
  product   Product      @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  related   Product      @relation("ProductRelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId, type])
  @@map("product_relations")
}

// ─────────────────────────────── Inventory ───────────────────────────────

enum LocationType {
  WAREHOUSE
  BRANCH
  WORKSHOP
}

enum StockReason {
  INITIAL
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVE
  RELEASE
  IMPORT
}

model Location {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  type          LocationType
  nameAr        String             @map("name_ar")
  nameEn        String?            @map("name_en")
  cityId        String?            @map("city_id") @db.Uuid
  isPickupPoint Boolean            @default(false) @map("is_pickup_point")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  stock         StockLevel[]
  movements     StockMovement[]
  reservations  StockReservation[]
  pickupOrders  Order[]

  @@map("locations")
}

/// Units for most items; centimetres for fabric sold by length.
model StockLevel {
  variantId         String         @map("variant_id") @db.Uuid
  locationId        String         @map("location_id") @db.Uuid
  onHand            Int            @default(0) @map("on_hand")
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5) @map("low_stock_threshold")
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location          Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([variantId, locationId])
  @@map("stock_levels")
}

model StockMovement {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  locationId String         @map("location_id") @db.Uuid
  /// Signed change to on_hand (or to reserved for RESERVE/RELEASE).
  quantity   Int
  reason     StockReason
  refType    String?        @map("ref_type")
  refId      String?        @map("ref_id")
  note       String?
  actorId    String?        @map("actor_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────── Jobs ───────────────────────────────

enum JobKind {
  PRODUCT_IMPORT
  PRODUCT_EXPORT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model BackgroundJob {
  id          String    @id @default(uuid()) @db.Uuid
  kind        JobKind
  status      JobStatus @default(QUEUED)
  inputKey    String?   @map("input_key")
  resultKey   String?   @map("result_key")
  /// { created, updated, failed, errors: [{ row, message }] }
  summary     Json?
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@map("background_jobs")
}

// ─────────────────────────────── Storefront: cart, wishlist, content, reviews ───────────────────────────────

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
  ABANDONED
}

/// A guest cart is identified by an opaque token (only its sha256 is stored); a customer cart by user.
model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  guestTokenHash String?    @unique @map("guest_token_hash")
  status         CartStatus @default(ACTIVE)
  lastActivityAt DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items          CartItem[]

  @@index([userId, status])
  @@index([status, lastActivityAt])
  @@map("carts")
}

model CartItem {
  id              String              @id @default(uuid()) @db.Uuid
  cartId          String              @map("cart_id") @db.Uuid
  variantId       String              @map("variant_id") @db.Uuid
  quantity        Int
  /// Fabric swatch sample of the variant instead of the product itself.
  isSample        Boolean             @default(false) @map("is_sample")
  /// For PER_METER (lengthCm) and PER_SQM (widthMm, heightMm) products.
  lengthCm        Int?                @map("length_cm")
  widthMm         Int?                @map("width_mm")
  heightMm        Int?                @map("height_mm")
  giftWrap        Boolean             @default(false) @map("gift_wrap")
  giftMessage     String?             @map("gift_message")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart            Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant         ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  configurationId String?             @map("configuration_id") @db.Uuid
  configuration   SavedConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@map("cart_items")
}

model WishlistItem {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

/// Notified when the variant becomes available again (delivery in the notifications phase).
model BackInStockSubscription {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  locale     Locale         @default(ar)
  notifiedAt DateTime?      @map("notified_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([variantId, userId])
  @@index([variantId, notifiedAt])
  @@map("back_in_stock_subscriptions")
}

enum BannerPlacement {
  HERO
  STRIP
  CATEGORY
}

/// Bilingual, scheduled merchandising banners. Each language has its own artwork (text is often in the image).
model Banner {
  id         String          @id @default(uuid()) @db.Uuid
  placement  BannerPlacement @default(HERO)
  titleAr    String          @map("title_ar")
  titleEn    String?         @map("title_en")
  subtitleAr String?         @map("subtitle_ar")
  subtitleEn String?         @map("subtitle_en")
  ctaAr      String?         @map("cta_ar")
  ctaEn      String?         @map("cta_en")
  /// Locale-less storefront path, e.g. "/c/abayas" or "/collections/ramadan".
  link       String?
  imageArId  String?         @map("image_ar_id") @db.Uuid
  imageEnId  String?         @map("image_en_id") @db.Uuid
  categoryId String?         @map("category_id") @db.Uuid
  startsAt   DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime?       @map("ends_at") @db.Timestamptz(3)
  isActive   Boolean         @default(true) @map("is_active")
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  imageAr    MediaAsset?     @relation("BannerImageAr", fields: [imageArId], references: [id], onDelete: SetNull)
  imageEn    MediaAsset?     @relation("BannerImageEn", fields: [imageEnId], references: [id], onDelete: SetNull)

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Customer reviews. Submission requires a delivered order (Phase 4+); the storefront lists approved ones.
model Review {
  id         String       @id @default(uuid()) @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  rating     Int
  title      String?
  body       String?      @db.Text
  locale     Locale       @default(ar)
  status     ReviewStatus @default(PENDING)
  authorName String?      @map("author_name")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@map("reviews")
}

// ─────────────────────────────── Shipping ───────────────────────────────

/// A delivery zone groups cities. The zone listing city code "*" covers every other city.
model ShippingZone {
  id        String             @id @default(uuid()) @db.Uuid
  code      String             @unique
  nameAr    String             @map("name_ar")
  nameEn    String             @map("name_en")
  isActive  Boolean            @default(true) @map("is_active")
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  cities    ShippingZoneCity[]
  rates     ShippingRate[]

  @@map("shipping_zones")
}

/// A city belongs to at most one zone.
model ShippingZoneCity {
  zoneId   String       @map("zone_id") @db.Uuid
  cityCode String       @unique @map("city_code")
  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([zoneId, cityCode])
  @@map("shipping_zone_cities")
}

model ShippingRate {
  id         String       @id @default(uuid()) @db.Uuid
  zoneId     String       @map("zone_id") @db.Uuid
  /// Carrier adapter key: OWN_FLEET, SMSA, ARAMEX, SPL.
  carrier    String
  /// STANDARD, EXPRESS, SAME_DAY.
  method     String
  nameAr     String       @map("name_ar")
  nameEn     String       @map("name_en")
  minWeightG Int          @default(0) @map("min_weight_g")
  maxWeightG Int?         @map("max_weight_g")
  /// Halalas, in the store's price basis (VAT-inclusive by default).
  price      Int
  freeAbove  Int?         @map("free_above")
  etaMinDays Int          @map("eta_min_days")
  etaMaxDays Int          @map("eta_max_days")
  isActive   Boolean      @default(true) @map("is_active")
  sortOrder  Int          @default(0) @map("sort_order")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  zone       ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, isActive])
  @@map("shipping_rates")
}

// ─────────────────────────────── Promotions ───────────────────────────────

enum PromotionType {
  PERCENT
  FIXED
  FREE_SHIPPING
  BXGY
  BUNDLE
}

model Promotion {
  id               String                @id @default(uuid()) @db.Uuid
  nameAr           String                @map("name_ar")
  nameEn           String                @map("name_en")
  type             PromotionType
  /// Applied without a code; otherwise redeemed through one of its coupons.
  automatic        Boolean               @default(false)
  priority         Int                   @default(0)
  stackable        Boolean               @default(true)
  /// Domain PromotionConditions: { minSubtotal, productIds, categoryIds, verticals, firstOrderOnly }.
  conditions       Json                  @default("{}")
  /// Domain PromotionBenefit: { percent, maxDiscount, amount, buyQuantity, getQuantity, getPercent, bundleQuantity, bundlePrice }.
  benefit          Json                  @default("{}")
  startsAt         DateTime?             @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?             @map("ends_at") @db.Timestamptz(3)
  usageLimit       Int?                  @map("usage_limit")
  perCustomerLimit Int?                  @map("per_customer_limit")
  usageCount       Int                   @default(0) @map("usage_count")
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  coupons          Coupon[]
  redemptions      PromotionRedemption[]

  @@index([isActive, automatic])
  @@map("promotions")
}

model Coupon {
  id          String                @id @default(uuid()) @db.Uuid
  promotionId String                @map("promotion_id") @db.Uuid
  /// Stored upper-case; matched case-insensitively.
  code        String                @unique
  usageLimit  Int?                  @map("usage_limit")
  usageCount  Int                   @default(0) @map("usage_count")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  promotion   Promotion             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions PromotionRedemption[]

  @@map("coupons")
}

/// One row per promotion used by an order; released when an unpaid order expires or is cancelled.
model PromotionRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  couponId    String?   @map("coupon_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  /// Guests are limited per phone number.
  phoneE164   String    @map("phone_e164")
  discount    Int
  released    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  coupon      Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promotionId, orderId])
  @@index([promotionId, phoneE164])
  @@map("promotion_redemptions")
}

// ─────────────────────────────── Orders ───────────────────────────────

enum OrderStatus {
  NEW
  PAID
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  INSTALLATION_SCHEDULED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  /// mada, Visa, Mastercard and Apple Pay on the gateway's hosted page.
  CARD
  TABBY
  TAMARA
  COD
}

enum PaymentProvider {
  SIMULATOR
  MOYASAR
  TABBY
  TAMARA
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderPaymentState {
  UNPAID
  PAID
  /// Cash on delivery: collected by the courier.
  PAY_ON_DELIVERY
  PARTIALLY_REFUNDED
  REFUNDED
}

/// Orders keep full snapshots (prices, names, address) so later catalog edits never change them.
model Order {
  id               String                @id @default(uuid()) @db.Uuid
  /// HD-2026-000123
  number           String                @unique
  userId           String?               @map("user_id") @db.Uuid
  locale           Locale                @default(ar)
  contactName      String                @map("contact_name")
  contactPhoneE164 String                @map("contact_phone_e164")
  contactEmail     String?               @map("contact_email")
  status           OrderStatus           @default(NEW)
  paymentMethod    PaymentMethod         @map("payment_method")
  paymentState     OrderPaymentState     @default(UNPAID) @map("payment_state")
  fulfillment      FulfillmentType
  /// { recipientName, phoneE164, cityCode, cityNameAr, cityNameEn, district, street, buildingNo, additionalNo, postalCode, shortAddress }
  shippingAddress  Json?                 @map("shipping_address")
  cityCode         String?               @map("city_code")
  shippingRateId   String?               @map("shipping_rate_id") @db.Uuid
  shippingCarrier  String?               @map("shipping_carrier")
  shippingMethod   String?               @map("shipping_method")
  shippingNameAr   String?               @map("shipping_name_ar")
  shippingNameEn   String?               @map("shipping_name_en")
  pickupLocationId String?               @map("pickup_location_id") @db.Uuid
  etaMinDays       Int?                  @map("eta_min_days")
  etaMaxDays       Int?                  @map("eta_max_days")
  currency         String                @default("SAR")
  vatRateBp        Int                   @map("vat_rate_bp")
  pricesIncludeVat Boolean               @map("prices_include_vat")
  /// All amounts in halalas.
  subtotal         Int
  discount         Int                   @default(0)
  giftWrapTotal    Int                   @default(0) @map("gift_wrap_total")
  shippingTotal    Int                   @default(0) @map("shipping_total")
  codFee           Int                   @default(0) @map("cod_fee")
  net              Int
  vat              Int
  total            Int
  refundedTotal    Int                   @default(0) @map("refunded_total")
  couponCode       String?               @map("coupon_code")
  /// { promotions: [{ id, code, type, nameAr, nameEn, discount }], vatBreakdown, shipping: {net,vat}, codFee: {net,vat} }
  pricing          Json                  @default("{}")
  customerNote     String?               @map("customer_note")
  cartId           String?               @map("cart_id") @db.Uuid
  /// Unpaid prepaid orders are cancelled and their stock released after this time.
  expiresAt        DateTime?             @map("expires_at") @db.Timestamptz(3)
  placedAt         DateTime              @default(now()) @map("placed_at") @db.Timestamptz(3)
  paidAt           DateTime?             @map("paid_at") @db.Timestamptz(3)
  deliveredAt      DateTime?             @map("delivered_at") @db.Timestamptz(3)
  cancelledAt      DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelReason     String?               @map("cancel_reason")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  pickupLocation   Location?             @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  events           OrderStatusEvent[]
  payments         Payment[]
  refunds          Refund[]
  invoices         TaxInvoice[]
  reservations     StockReservation[]
  redemptions      PromotionRedemption[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([contactPhoneE164])
  @@index([paymentState, expiresAt])
  @@map("orders")
}

model OrderItem {
  id              String             @id @default(uuid()) @db.Uuid
  orderId         String             @map("order_id") @db.Uuid
  variantId       String?            @map("variant_id") @db.Uuid
  productId       String?            @map("product_id") @db.Uuid
  sku             String
  nameAr          String             @map("name_ar")
  nameEn          String?            @map("name_en")
  /// [{ attributeKey, nameAr, nameEn, labelAr, labelEn }]
  options         Json               @default("[]")
  imageUrl        String?            @map("image_url")
  pricingMode     PricingMode        @map("pricing_mode")
  isMadeToMeasure Boolean            @map("is_made_to_measure")
  isSample        Boolean            @default(false) @map("is_sample")
  lengthCm        Int?               @map("length_cm")
  widthMm         Int?               @map("width_mm")
  heightMm        Int?               @map("height_mm")
  billedMeasure   Int?               @map("billed_measure")
  quantity        Int
  /// Unit price as charged, in the store's price basis.
  unitPrice       Int                @map("unit_price")
  discount        Int                @default(0)
  giftWrap        Boolean            @default(false) @map("gift_wrap")
  giftWrapTotal   Int                @default(0) @map("gift_wrap_total")
  giftMessage     String?            @map("gift_message")
  net             Int
  vat             Int
  vatRateBp       Int                @map("vat_rate_bp")
  total           Int
  weightGrams     Int                @default(0) @map("weight_grams")
  sortOrder       Int                @default(0) @map("sort_order")
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reservations    StockReservation[]
  configurationId String?            @map("configuration_id") @db.Uuid
  /// Workshop specification at the time of the order: { templateCode, kind, version, inputs, specs, lines }.
  configuration   Json?

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

enum ReservationStatus {
  ACTIVE
  /// Converted into a SALE movement (payment confirmed or COD order confirmed).
  COMMITTED
  RELEASED
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  orderItemId String            @map("order_item_id") @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  locationId  String            @map("location_id") @db.Uuid
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  location    Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@map("stock_reservations")
}

// ─────────────────────────────── Payments ───────────────────────────────

model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  provider      PaymentProvider
  method        PaymentMethod
  status        PaymentStatus   @default(PENDING)
  amount        Int
  currency      String          @default("SAR")
  /// Gateway reference: Moyasar invoice id, Tabby payment id, Tamara order id.
  providerRef   String?         @map("provider_ref")
  /// Hosted payment page the customer is sent to.
  redirectUrl   String?         @map("redirect_url")
  /// Card scheme and last digits or BNPL plan as reported by the gateway (never full card data).
  sourceSummary String?         @map("source_summary")
  failureCode   String?         @map("failure_code")
  failureReason String?         @map("failure_reason")
  raw           Json?
  authorizedAt  DateTime?       @map("authorized_at") @db.Timestamptz(3)
  capturedAt    DateTime?       @map("captured_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds       Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  paymentId    String       @map("payment_id") @db.Uuid
  amount       Int
  reason       String
  status       RefundStatus @default(PENDING)
  providerRef  String?      @map("provider_ref")
  creditNoteId String?      @unique @map("credit_note_id") @db.Uuid
  actorId      String?      @map("actor_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditNote   TaxInvoice?  @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

/// Gateway webhook deliveries, deduplicated by the gateway's event id.
model WebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id")
  type        String
  payload     Json
  processedAt DateTime?       @map("processed_at") @db.Timestamptz(3)
  error       String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

/// Replays the response of a request repeated with the same Idempotency-Key.
model IdempotencyKey {
  scope       String
  key         String
  /// sha256 of the request body; reusing a key with a different body is rejected.
  requestHash String   @map("request_hash")
  status      Int?
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Gap-free yearly sequences for order numbers.
model DocumentCounter {
  key   String @id
  value Int    @default(0)

  @@map("document_counters")
}

// ─────────────────────────────── Invoicing (ZATCA) ───────────────────────────────

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum ZatcaStatus {
  /// Signed and stored; reporting is off (no production CSID configured).
  NOT_SUBMITTED
  PENDING
  REPORTED
  REPORTED_WITH_WARNINGS
  REJECTED
  FAILED
}

/// Simplified tax invoices and credit notes, chained per EGS unit: each document stores the hash of the previous one.
model TaxInvoice {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  kind          InvoiceKind
  /// INV-2026-000001 / CN-2026-000001
  number        String       @unique
  uuid          String       @unique @db.Uuid
  /// Invoice counter value: strictly increasing, no gaps.
  icv           Int          @unique
  previousHash  String       @map("previous_hash")
  /// Base64 SHA-256 of the canonical invoice XML.
  hash          String       @unique
  signature     String
  xml           String       @db.Text
  qr            String       @db.Text
  issuedAt      DateTime     @map("issued_at") @db.Timestamptz(3)
  net           Int
  vat           Int
  total         Int
  /// Credit notes reference the original invoice.
  originalId    String?      @map("original_id") @db.Uuid
  reason        String?
  /// Seller, buyer and line data as printed.
  snapshot      Json
  zatcaStatus   ZatcaStatus  @default(NOT_SUBMITTED) @map("zatca_status")
  zatcaResponse Json?        @map("zatca_response")
  zatcaAttempts Int          @default(0) @map("zatca_attempts")
  reportedAt    DateTime?    @map("reported_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  original      TaxInvoice?  @relation("CreditNotes", fields: [originalId], references: [id], onDelete: Restrict)
  creditNotes   TaxInvoice[] @relation("CreditNotes")
  refund        Refund?

  @@index([orderId])
  @@index([zatcaStatus])
  @@map("tax_invoices")
}

/// Single-row chain head for the e-invoicing unit, locked while a document is issued.
model InvoiceChain {
  id       String @id
  lastIcv  Int    @default(0) @map("last_icv")
  lastHash String @map("last_hash")

  @@map("invoice_chain")
}

// ─────────────────────────────── Configurator (made-to-measure) ───────────────────────────────

enum ConfiguratorKind {
  CURTAIN
  BLIND
  ABAYA
  SOFA_COVER
}

enum OptionPriceBasis {
  FLAT
  PER_METER
  PER_SQM
  PER_PANEL
  PER_WIDTH_M
  PER_PIECE
}

/// Admin-configurable rules for a made-to-measure product family. Every change bumps `version`;
/// configurations and order lines record the version they were priced with.
model ConfiguratorTemplate {
  id             String               @id @default(uuid()) @db.Uuid
  code           String               @unique
  kind           ConfiguratorKind
  nameAr         String               @map("name_ar")
  nameEn         String               @map("name_en")
  version        Int                  @default(1)
  /// Named numbers used by the formulas, e.g. { sideHem: 50, cutRounding: 100 } (mm).
  constants      Json                 @default("{}")
  /// Formula overrides by result name (widths, cutLength, fabricLength, railLength, billableArea).
  formulas       Json                 @default("{}")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  headingStyles  HeadingStyle[]
  options        ConfiguratorOption[]
  products       Product[]
  configurations SavedConfiguration[]

  @@map("configurator_templates")
}

model HeadingStyle {
  id              String               @id @default(uuid()) @db.Uuid
  templateId      String               @map("template_id") @db.Uuid
  /// WAVE, PINCH_PLEAT, EYELET, ROD_POCKET
  code            String
  nameAr          String               @map("name_ar")
  nameEn          String               @map("name_en")
  /// Fullness ratios in hundredths (220 = 2.2×).
  fullnessMin     Int                  @map("fullness_min")
  fullnessMax     Int                  @map("fullness_max")
  fullnessDefault Int                  @map("fullness_default")
  /// Halalas per metre of rail.
  makingCostPerM  Int                  @map("making_cost_per_m")
  sortOrder       Int                  @default(0) @map("sort_order")
  isActive        Boolean              @default(true) @map("is_active")
  template        ConfiguratorTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@map("heading_styles")
}

model ConfiguratorOption {
  id            String               @id @default(uuid()) @db.Uuid
  templateId    String               @map("template_id") @db.Uuid
  /// MOUNTING, LINING, TRACK, MOTOR, INSTALLATION, CONTROL, FABRIC, TAILORING (single choice);
  /// ACCESSORY, EXTRA (multiple); PIECE (sofa pieces with quantities).
  group         String
  code          String
  nameAr        String               @map("name_ar")
  nameEn        String               @map("name_en")
  descriptionAr String?              @map("description_ar")
  descriptionEn String?              @map("description_en")
  priceBasis    OptionPriceBasis     @map("price_basis")
  /// Halalas per unit of the price basis, VAT-inclusive like catalog prices.
  price         Int
  isDefault     Boolean              @default(false) @map("is_default")
  sortOrder     Int                  @default(0) @map("sort_order")
  isActive      Boolean              @default(true) @map("is_active")
  template      ConfiguratorTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, group, code])
  @@map("configurator_options")
}

/// A customer's made-to-measure specification, attached to a cart line and snapshotted on the order.
model SavedConfiguration {
  id              String               @id @default(uuid()) @db.Uuid
  templateId      String               @map("template_id") @db.Uuid
  templateVersion Int                  @map("template_version")
  productId       String               @map("product_id") @db.Uuid
  variantId       String               @map("variant_id") @db.Uuid
  userId          String?              @map("user_id") @db.Uuid
  /// Customer inputs (dimensions in mm, choices, measurements, pieces, photo ids, notes).
  inputs          Json
  /// Last quote: { lines, specs } — the workshop specification.
  computed        Json
  total           Int
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  template        ConfiguratorTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  cartItems       CartItem[]
  uploads         CustomerUpload[]

  @@index([userId])
  @@map("saved_configurations")
}

/// Saved abaya body measurements (mm) for reuse.
model MeasurementProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String
  measurements Json
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("measurement_profiles")
}

/// Customer photos (e.g. of a sofa), stored in the private bucket and visible to staff only.
model CustomerUpload {
  id              String              @id @default(uuid()) @db.Uuid
  storageKey      String              @unique @map("storage_key")
  contentType     String              @map("content_type")
  width           Int
  height          Int
  bytes           Int
  userId          String?             @map("user_id") @db.Uuid
  configurationId String?             @map("configuration_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  configuration   SavedConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  @@index([configurationId])
  @@index([createdAt])
  @@map("customer_uploads")
}
