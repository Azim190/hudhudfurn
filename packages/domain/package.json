{
  "name": "@hudhud/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure business logic: money, VAT, pricing, configurator, ZATCA, RBAC. No I/O.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@hudhud/config": "workspace:*",
    "@vitest/coverage-v8": "3.2.7",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
